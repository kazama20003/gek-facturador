// Persistence model (infrastructure). The domain never sees Prisma types;
// prisma-invoice.repository.ts + its mapper translate in both directions.
// Conventions: snake_case, singular table names, FKs as id_<entity>.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Issued electronic invoice plus its SUNAT submission outcome.
model invoice {
  id                     String   @id
  document_type          String
  series                 String
  correlative            Int
  issue_date             DateTime
  currency               String
  issuer_ruc             String
  issuer_business_name   String
  issuer_trade_name      String?
  issuer_ubigeo          String?
  issuer_department      String?
  issuer_province        String?
  issuer_district        String?
  issuer_address_line    String?
  customer_ruc           String
  customer_doc_type      String   @default("6")
  customer_business_name String
  taxable_amount         Decimal  @db.Decimal(12, 2)
  igv                    Decimal  @db.Decimal(12, 2)
  sale_value             Decimal  @db.Decimal(12, 2)
  total                  Decimal  @db.Decimal(12, 2)
  /// ISSUED | ACCEPTED | REJECTED
  status                 String
  sunat_file_name        String?
  cdr_response_code      String?
  cdr_description        String?
  cdr_notes              String[] @default([])
  cdr_zip_base64         String?
  signed_xml             String?
  created_at             DateTime @default(now())

  items invoice_item[]

  @@unique([issuer_ruc, document_type, series, correlative])
  @@index([issuer_ruc])
}

/// Invoice line, amounts as computed by the domain.
model invoice_item {
  id          String  @id @default(uuid())
  id_invoice  String
  line_number Int
  code        String?
  description String
  unit_code   String
  quantity    Decimal @db.Decimal(12, 3)
  unit_value  Decimal @db.Decimal(12, 2)
  taxable_amount Decimal @db.Decimal(12, 2)
  igv         Decimal @db.Decimal(12, 2)
  unit_price  Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice invoice @relation(fields: [id_invoice], references: [id], onDelete: Cascade)

  @@index([id_invoice])
}

/// Credit/debit note plus its SUNAT submission outcome.
model note {
  id                     String   @id
  document_type          String
  series                 String
  correlative            Int
  issue_date             DateTime
  currency               String
  reason_code            String
  reason_description     String
  modified_document_type String
  modified_series        String
  modified_correlative   Int
  issuer_ruc             String
  issuer_business_name   String
  issuer_trade_name      String?
  issuer_ubigeo          String?
  issuer_department      String?
  issuer_province        String?
  issuer_district        String?
  issuer_address_line    String?
  customer_ruc           String
  customer_business_name String
  taxable_amount         Decimal  @db.Decimal(12, 2)
  igv                    Decimal  @db.Decimal(12, 2)
  sale_value             Decimal  @db.Decimal(12, 2)
  total                  Decimal  @db.Decimal(12, 2)
  /// ISSUED | ACCEPTED | REJECTED
  status                 String
  sunat_file_name        String?
  cdr_response_code      String?
  cdr_description        String?
  cdr_notes              String[] @default([])
  cdr_zip_base64         String?
  signed_xml             String?
  created_at             DateTime @default(now())

  items note_item[]

  @@unique([issuer_ruc, document_type, series, correlative])
  @@index([issuer_ruc])
}

/// Note line, amounts as computed by the domain.
model note_item {
  id             String  @id @default(uuid())
  id_note        String
  line_number    Int
  code           String?
  description    String
  unit_code      String
  quantity       Decimal @db.Decimal(12, 3)
  unit_value     Decimal @db.Decimal(12, 2)
  taxable_amount Decimal @db.Decimal(12, 2)
  igv            Decimal @db.Decimal(12, 2)
  unit_price     Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  note note @relation(fields: [id_note], references: [id], onDelete: Cascade)

  @@index([id_note])
}

/// Asynchronous SUNAT submission (RC daily summary / RA voided communication).
model sunat_submission {
  id                String   @id @default(uuid())
  /// RC (resumen diario) | RA (comunicacion de baja)
  kind              String
  document_id       String
  file_name         String
  ticket            String
  status_code       String
  cdr_response_code String?
  cdr_description   String?
  cdr_notes         String[] @default([])
  cdr_zip_base64    String?
  signed_xml        String?
  created_at        DateTime @default(now())

  @@index([kind, document_id])
}
