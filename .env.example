# Copiar a .env y ajustar

# PostgreSQL (si falta, la app usa un repositorio en memoria y lo advierte)
DATABASE_URL="postgresql://emitec:emitec@localhost:5432/emitec?schema=public"

PORT=3000

# Certificado de firma (PFX tiene prioridad; sin configurar usa el cert de prueba)
# SIGN_PFX_PATH=./certs/certificado.pfx
# SIGN_PFX_PASSWORD=...
# SIGN_KEY_PATH=./certs/key.pem
# SIGN_CERT_PATH=./certs/cert.pem

# SUNAT (defaults: beta con MODDATOS/moddatos)
# SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# SUNAT_SOL_USERNAME=20000000001MODDATOS
# SUNAT_SOL_PASSWORD=moddatos
